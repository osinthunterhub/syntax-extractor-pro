# NEW bot only. Never the existing TurboForwarderPro_Bot.
BOT_TOKEN=
EXPECTED_BOT_USERNAME=
WEBHOOK_SECRET=
PUBLIC_BASE_URL=
# Exact API DNS hostname(s) for your authorized coaching account, comma separated.
# Empty disables AppX until an authorized coaching host is approved.
APPX_API_HOSTS=
# Change to true only on the NEW service after verifying its bot identity.
SET_WEBHOOK=false
PORT=10000

# Optional NEW project owner, numeric Telegram user ID. 0 disables owner commands.
OWNER_ID=0

# Default is Bot API. Optional official MTProto transport for this SAME NEW bot.
# No phone login or personal user session. Secrets belong in hosting environment.
TELEGRAM_TRANSPORT=botapi
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_BOT_SESSION=
OWNER_READY_NOTICE=false

# Maintenance-only staged deployment; final production value must be false.
TELEGRAM_START_PAUSED=false
